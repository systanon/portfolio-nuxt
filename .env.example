# Local development (pnpm dev / pnpm build run on the same machine, so the
# plain names below are enough — nuxt.config.ts reads them directly).
API_BASE=/api/v1
GO_BACKEND_URL=http://127.0.0.1:3000
GO_BACKEND_INTERNAL=http://127.0.0.1:3000/v1
WS_API=ws://127.0.0.1:3000/v1/ws
GOOGLE_AUTH_URL=http://127.0.0.1:3000/v1/auth/google

# Production (VPS) — these plain names only affect what gets baked in if set
# on the machine that runs `pnpm build`. The running container must instead
# get its config from nuxt.env using the NUXT_/NUXT_PUBLIC_-prefixed names,
# which Nitro applies as a runtime override regardless of the build machine:
#
#   NUXT_API_INTERNAL=http://go_app:3000/v1
#   NUXT_PUBLIC_API_BASE=/api/v1
#   NUXT_PUBLIC_WS_URL=wss://tustanovskyi.com/v1/ws
#   NUXT_PUBLIC_API_URL=https://tustanovskyi.com
#   NUXT_PUBLIC_GOOGLE_AUTH_URL=https://app.tustanovskyi.com/v1/auth/google
#   NUXT_PUBLIC_SITE_URL=https://app.tustanovskyi.com
#
# GO_BACKEND_URL is the one exception: routeRules['/api/**'] in
# nuxt.config.ts is resolved into a static Nitro proxy rule at build time,
# so it must be set correctly wherever `pnpm build` runs (a repo Variable
# in CI, or exported in the shell for a manual build) — there's no runtime
# override for it.
