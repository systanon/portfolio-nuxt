{
  "name": "portfolio-nuxt",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --port 3001",
    "generate": "nuxt generate",
    "preview": "nuxt preview --port 3001",
    "prepare": "husky",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:unit": "TSX_TSCONFIG_PATH=.nuxt/tsconfig.app.json node --import tsx --test test/unit/*.spec.ts",
    "test:ui": "vitest run",
    "test": "pnpm test:unit && pnpm test:ui"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,vue}": "eslint --fix"
  },
  "dependencies": {
    "@pinia/nuxt": "^0.11.3",
    "@vuelidate/core": "^2.0.3",
    "@vuelidate/validators": "^2.0.4",
    "@vueuse/components": "^14.2.1",
    "@vueuse/nuxt": "^14.2.1",
    "eventemitter3": "^5.0.4",
    "gsap": "^3.14.2",
    "nuxt": "^4.3.1",
    "vue": "^3.5.28",
    "vue-router": "^4.6.4"
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.22.2",
    "pnpm": ">=10.0.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.16.0",
    "@nuxt/test-utils": "^4.0.0",
    "@types/node": "^25.5.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.8.0",
    "happy-dom": "^20.8.9",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "nuxt-svg-sprite-icon": "^2.0.4",
    "sass": "^1.97.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.2"
  }
}
